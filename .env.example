# Fixture mode works without any environment variables in development/test.
# Production is fail-closed: set DATABASE_URL and AUTH_SECRET before build/deploy.

# Optional PostgreSQL persistence
DATABASE_URL=
DATABASE_URL_ANON=

# Optional NextAuth configuration
AUTH_SECRET=
AUTH_TRUST_HOST=true

LIVEOPS_OPERATOR_KEY=
ARCHIVE_MASTER_PASSWORD=
LIVEOPS_SERVER_API_KEY=
NEXT_PUBLIC_ORIGIN=http://localhost:3010
LIVEOPS_RATE_LIMIT_DISABLE=

# Optional OpenAI-compatible assistant
LIVEOPS_LLM_BASE_URL=
LIVEOPS_LLM_MODEL=
LIVEOPS_LLM_API_KEY=

# Optional email notifications
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# Optional SMS notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
